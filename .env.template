# ─── Required ─────────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram user/group/channel ID
# DM @userinfobot on Telegram to find your chat ID
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── Optional: WhatsApp via Twilio ─────────────────────────
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio sandbox: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Your WhatsApp number with country code e.g. +12125551234
WHATSAPP_TO=

# ─── Scraper settings ──────────────────────────────────────
POLL_INTERVAL_MINUTES=30
HOURS_OLD=24
RESULTS_PER_SOURCE=50
LOCATION=United States

# ─── Database ──────────────────────────────────────────────
DB_PATH=/data/jobs.db

# ─── Optional proxy (helps avoid IP blocks on Indeed/LinkedIn)
# Format: http://user:pass@host:port
PROXY_URL=
